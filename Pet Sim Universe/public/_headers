/
  Cache-Control: no-cache, max-age=0, must-revalidate
/index.html
  Cache-Control: no-cache, max-age=0, must-revalidate
/404.html
  Cache-Control: no-cache, max-age=0, must-revalidate
/app.js
  Cache-Control: no-cache, max-age=0, must-revalidate
/data/*
  Cache-Control: no-store
/bundle/*
  Cache-Control: public, max-age=31536000, immutable
/assets/optimized/*
  Cache-Control: public, max-age=31536000, immutable
/api/*
  Cache-Control: no-store
